<Project Sdk="Microsoft.NET.Sdk.Worker">

  <Sdk Name="StuDev.AotAnywhere" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Size trimming for the NativeAOT binary (about -12% on linux-x64). UseSystemResourceKeys is deliberately left
         off: it saves only ~0.5% but turns runtime error messages reported to the Panel into resource keys. -->
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <AgentBuildVersion Condition="'$(AgentBuildVersion)' == ''">$(Version)</AgentBuildVersion>
    <AgentRuntimeIdentifier Condition="'$(AgentRuntimeIdentifier)' == ''">$(RuntimeIdentifier)</AgentRuntimeIdentifier>
    <GeneratedBuildInfo>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/BuildInfo.g.cs</GeneratedBuildInfo>
  </PropertyGroup>

  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(GeneratedBuildInfo)'))" />
    <WriteLinesToFile File="$(GeneratedBuildInfo)" Overwrite="true" Lines="namespace HyPanel.Agent%3B internal static class BuildInfo { public const string Version = &quot;$(AgentBuildVersion)&quot;%3B private const string PublishedRuntimeIdentifier = &quot;$(AgentRuntimeIdentifier)&quot;%3B public static string RuntimeIdentifier => string.IsNullOrEmpty(PublishedRuntimeIdentifier) ? System.Runtime.InteropServices.RuntimeInformation.RuntimeIdentifier : PublishedRuntimeIdentifier%3B }" />
    <ItemGroup><Compile Include="$(GeneratedBuildInfo)" /></ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyPanel.Shared\HyPanel.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>HyPanel.Agent.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
