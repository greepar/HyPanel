<Project Sdk="Microsoft.NET.Sdk.Web">

  <Sdk Name="StuDev.AotAnywhere" />

  <ItemGroup>
    <ProjectReference Include="..\HyPanel.Shared\HyPanel.Shared.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>HyPanel.Server.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>true</PublishTrimmed>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <WebProjectDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../web/HyPanel.Web'))</WebProjectDirectory>
    <ServerBuildVersion Condition="'$(ServerBuildVersion)' == ''">$(Version)</ServerBuildVersion>
    <ServerRuntimeIdentifier Condition="'$(ServerRuntimeIdentifier)' == ''">$(RuntimeIdentifier)</ServerRuntimeIdentifier>
    <GeneratedBuildInfo>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/ServerBuildInfo.g.cs</GeneratedBuildInfo>
  </PropertyGroup>

  <Target Name="GenerateServerBuildInfo" BeforeTargets="CoreCompile">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(GeneratedBuildInfo)'))" />
    <WriteLinesToFile File="$(GeneratedBuildInfo)" Overwrite="true" Lines="namespace HyPanel.Server%3B internal static class ServerBuildInfo { public const string Version = &quot;$(ServerBuildVersion)&quot;%3B private const string PublishedRuntimeIdentifier = &quot;$(ServerRuntimeIdentifier)&quot;%3B public static string RuntimeIdentifier => string.IsNullOrEmpty(PublishedRuntimeIdentifier) ? System.Runtime.InteropServices.RuntimeInformation.RuntimeIdentifier : PublishedRuntimeIdentifier%3B }" />
    <ItemGroup><Compile Include="$(GeneratedBuildInfo)" /></ItemGroup>
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Endpoints/DefaultMihomoTemplate.yaml" LogicalName="HyPanel.Server.DefaultMihomoTemplate.yaml" />
  </ItemGroup>

  <Target Name="BuildAndEmbedWebAssets" BeforeTargets="BeforeBuild">
    <Exec Command="npm run build" WorkingDirectory="$(WebProjectDirectory)" />
    <ItemGroup>
      <_WebIndex Include="$(WebProjectDirectory)/dist/index.html" />
      <_WebAsset Include="$(WebProjectDirectory)/dist/assets/*" />
      <EmbeddedResource Include="@(_WebIndex)">
        <LogicalName>HyPanel.Web/index.html</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="@(_WebAsset)">
        <LogicalName>HyPanel.Web/assets/%(_WebAsset.Filename)%(_WebAsset.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
